# Copy to .env and fill in. Never commit .env.
#
# Free SerpApi account -> https://serpapi.com/users/sign_up (250 credits/month)
SERPAPI_KEY=

# live  = call SerpApi on cache misses and fill the cache (costs credits)
# cache = never touch the network; serve only what is already cached.
#         Use this for the demo recording and for anyone cloning the repo
#         without a key.
SERP_MODE=live

# Hard ceiling on SerpApi calls per server process. The free plan gives 250
# credits a MONTH, so this guard exists to stop a bad loop from burning them.
SERP_MAX_CREDITS=40

# Where responses are cached. Point at fixtures/serp-cache.sqlite together
# with SERP_MODE=cache to run fully offline.
SERP_CACHE_PATH=data/serp-cache.sqlite
SERP_CACHE_TTL=168h

# Comma-separated hl= values used for multilingual discovery. State portals
# publish in the local language, so this genuinely surfaces different schemes
# rather than just translating the UI.
SERP_DISCOVERY_LANGS=en,hi

PORT=8080
CORS_ORIGINS=http://localhost:3000
